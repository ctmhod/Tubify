{
  "manifest_version": 2,
  "name": "Tubify Tweaks",
  "version": "1.0.0",
  "description": "Tubify interface tweaks for YouTube: hide Shorts, suggestions and comments.",
  "browser_specific_settings": {
    "gecko": {
      "id": "tweaks@tubify.app"
    }
  },
  "permissions": ["storage"],
  "background": {
    "scripts": ["background.js"],
    "persistent": false
  },
  "content_scripts": [
    {
      "matches": ["*://m.youtube.com/*", "*://www.youtube.com/*", "*://youtube.com/*"],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ]
}

{
  "manifest_version": 2,
  "name": "Tubify Tweaks",
  "version": "1.8.5",
  "description": "Tubify interface tweaks for YouTube: hide Shorts, suggestions and comments.",
  "browser_specific_settings": {
    "gecko": {
      "id": "tweaks@tubify.app"
    }
  },
  "permissions": [
    "storage",
    "tabs",
    "geckoViewAddons",
    "nativeMessaging",
    "*://m.youtube.com/*",
    "*://www.youtube.com/*",
    "*://youtube.com/*"
  ],
  "background": {
    "scripts": [
      "background.js"
    ],
    "persistent": true
  },
  "content_scripts": [
    {
      "matches": [
        "*://m.youtube.com/*",
        "*://www.youtube.com/*",
        "*://youtube.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start",
      "all_frames": false
    }
  ]
}